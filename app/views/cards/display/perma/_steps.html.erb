<ol class="steps txt-small margin-block-start-auto">
  <%= render partial: "cards/steps/step", collection: card.steps.roots, as: :step %>
  <%= render "cards/steps/new", card: card, parent: nil unless card.closed? %>
</ol>

<% unless card.closed? %>
  <details class="steps__templates txt-x-small">
    <summary>Step templates</summary>
    <%= turbo_frame_tag card, :templating, src: new_card_templating_path(card), loading: :lazy do %>
      <span class="translucent">Loading…</span>
    <% end %>
  </details>
<% end %>
