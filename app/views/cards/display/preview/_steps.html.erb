<% tasks = card.steps.reject(&:section?) %>
<% if tasks.any? %>
  <div class="card__steps align-center gap-half flex-item-justify-end flex-item-no-shrink">
    <span class="steps__icon">
      <%= icon_tag "check" %>
    </span>
    <strong><%= "#{tasks.count(&:completed?)}/#{tasks.size}" %></strong>
  </div>
<% end %>