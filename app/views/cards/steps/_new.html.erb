<% label = parent ? "Add a sub-step" : "Add a step" %>
<li id="<%= dom_id(parent || card, :new_step) %>" class="step">
  <input type="checkbox" class="checkbox" disabled>
  <%= form_with model: [card, Step.new], url: card_steps_path(card), class: "min-width", data: { controller: "form", action: "submit->form#preventEmptySubmit submit->form#preventComposingSubmit turbo:submit-end->form#reset" } do |form| %>
    <%= form.hidden_field :parent_id, value: parent&.id %>
    <%= form.text_field :content, class: "input step__content hide-focus-ring", placeholder: "#{label}…", title: "End with a colon to make a section", autocomplete: "off", data: { form_target: "input", "1p-ignore": "true", action: "compositionstart->form#compositionStart compositionend->form#compositionEnd" }, aria: { label: label } %>
  <% end %>
</li>
